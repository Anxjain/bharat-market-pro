# ─────────────────────────────────────────────────────────────────────────────
# Bharat Market Pro — SERVER env. Copy to `server/.env` (gitignored) and fill in.
# Server-side only: never bundled into the browser build.
#
# The ONLY required value is DATABASE_URL. Everything below it is optional and
# turns on a specific feature — the app runs without any API key at all.
# ─────────────────────────────────────────────────────────────────────────────

# ——— Required ———
# Matches the Postgres provisioned by docker-compose.yml. When running the
# server outside Docker against the compose database, use localhost:5433.
DATABASE_URL=postgres://bharat_market_pro:bharat_market_pro@localhost:5433/bharat_market_pro

# Port that serves BOTH the API and the built frontend.
PORT=9787

# ——— Login (OPTIONAL) ———
# Your Supabase project URL. The server verifies login tokens against this
# project's public keys (ES256/RS256). Unset = auth disabled, app runs anonymously.
SUPABASE_URL=
# Only for older Supabase projects that still sign tokens with a shared HS256
# secret. Modern projects don't need this — SUPABASE_URL is enough.
SUPABASE_JWT_SECRET=

# ——— Private investment sections (OPTIONAL) ———
# "Investment Guidance" and "My Investments". OFF by default: while false these
# routes 404 and the public app is unchanged.
GUIDANCE_ENABLED=false
# Comma-separated ADMIN emails, matched against the verified login token. Admins
# get the sections plus the fact-sheet upload tools and the access panel (from
# which they can grant access to other signed-up users).
#
# In production an EMPTY list denies everyone rather than admitting everyone —
# a forgotten setting gives you a locked door, not an open one.
GUIDANCE_OWNER_EMAILS=
# DEV ONLY: skip the admin check so you can test on localhost without logging in.
# Ignored entirely when NODE_ENV=production.
GUIDANCE_DEV_OPEN=false

# ——— AI assistant (OPTIONAL) ———
# Powers the research chat and written summaries. Without a key those panels
# report "not configured"; every other feature — including the whole ULIP
# fact-sheet pipeline — works normally, because extraction runs offline.
# Gemini:  https://aistudio.google.com/apikey
# Groq:    https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Per-IP rate limit (requests/min) on the AI endpoints, to bound spend.
CHAT_RATE_LIMIT=20

# ——— ULIP fact-sheet pipeline ———
# Fact-sheets are parsed OFFLINE by the per-insurer extractors in
# server/extractors/ (Python + PyMuPDF). Point this at your interpreter if it
# isn't `python3` (on Windows, usually `python`).
ULIP_PYTHON=python3
# Set 1 to force the AI extractor instead of the offline one. Debugging only.
ULIP_SKIP_LOCAL=0

# Where source PDFs are archived, and where manually supplied ones are picked up.
# Relative paths resolve against the project root. In Docker these are set to
# /data/... by docker-compose.yml so they land on persistent volumes.
RAW_DIR=./raw
ULIP_FACTSHEET_DIR=./factsheets
ULIP_INTAKE_DIR=./intake

# Headless Chromium for the two insurers behind bot protection.
ULIP_CHROMIUM=0
# CHROMIUM_PATH=/usr/bin/chromium

# ——— Scheduled jobs ———
SCHEDULER_ENABLED=true
# 1 lets scheduled jobs fetch from the internet. Leave 0 during setup.
SCHEDULER_FETCH=0
SCHEDULER_TZ=Asia/Kolkata

# ——— Email (OPTIONAL) ———
# Used for the daily digest and portfolio alerts. Without these, emails are
# skipped and logged — nothing breaks. A Gmail app password works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to GUIDANCE_OWNER_EMAILS when unset.
DIGEST_TO=
