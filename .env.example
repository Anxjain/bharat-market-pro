# ─────────────────────────────────────────────────────────────────────────────
# Bharat Market Pro — ROOT env (build-time + infrastructure). Read by docker compose.
# Copy to `.env` and edit. Secrets for the running server go in server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ——— Public hostname / TLS ———
# Leave DOMAIN unset to serve plain HTTP on :80 (fine for local use).
# Set it to your own domain and Caddy obtains + renews a Let's Encrypt
# certificate automatically, and redirects HTTP -> HTTPS.
DOMAIN=
ACME_EMAIL=

# Base URL used for links inside outgoing emails. Defaults to https://$DOMAIN.
PUBLIC_URL=

# ——— Database ———
# CHANGE THIS before exposing the app to a network. Compose passes it to both
# Postgres and the app, so the two always agree.
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# ——— Login (OPTIONAL) ———
# Only enables accounts: per-user watchlists and the private investment sections.
# Leave unset to run fully anonymously (watchlists stay in the browser).
#
# These are BUILD-TIME values: Vite inlines them into the frontend bundle, so
# after changing either you must rebuild (`docker compose up -d --build`), not
# just restart. The anon/publishable key is a PUBLIC key — safe to ship.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ——— Background jobs ———
# SCHEDULER_FETCH=1 lets scheduled jobs reach the internet. Leave it 0 while
# you're still setting things up.
SCHEDULER_ENABLED=true
SCHEDULER_FETCH=0
SCHEDULER_TZ=Asia/Kolkata

# Headless Chromium for the two insurers behind bot protection. 1 in Docker
# (the image ships Chromium); 0 if no browser is available.
ULIP_CHROMIUM=1
